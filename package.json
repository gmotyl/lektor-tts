{
  "name": "lektor-tts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lektor TTS: a Chrome/Edge MV3 extension that reads pages aloud through an OpenAI-compatible /audio/speech engine",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "test": "node --test \"src/**/*.test.mjs\" \"scripts/__tests__/*.test.mjs\"",
    "icons": "node scripts/render-icons.mjs",
    "build": "node build.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.0"
  }
}
